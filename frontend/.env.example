# Public browser configuration; rebuild Next.js after changing these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: both API_BASE_URL and SITE_URL require non-local HTTPS.
# No Resend key belongs here. Configure SMTP credentials in Supabase only.
